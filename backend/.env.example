# Copy to .env and fill in. .env is not committed to git.
PORT=5000
# The live database (used by the deployed server, and by any run that does not set APP_ENV)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/stop_db
# The developer copy, used only when APP_ENV=dev (`npm start` sets it for local runs)
DEV_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/stop_dev
# Password for certs/stop-server.pfx (the HTTPS certificate; also not committed)
SSL_PFX_PASSWORD=CHANGE_ME
# Browser addresses allowed to call the API, comma-separated
CORS_ORIGINS=https://192.168.1.133:5173,https://localhost:5173
# How long a login lasts before staff must log in again
SESSION_HOURS=12
